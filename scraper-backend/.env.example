# -----------------------------------------------------------------------------
# Scraper Backend — Environment
# Copy to .env and fill in. Never commit .env.
# -----------------------------------------------------------------------------

# HTTP
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Pretty-print logs in dev (true/false). Always false in production.
LOG_PRETTY=true

# Authentication
# Comma-separated list of valid API keys (bearer tokens) accepted on
# every /v1/* route except /v1/health. Rotate by adding the new key,
# redeploying, then removing the old one after clients have swapped.
API_KEYS=change-me-primary,change-me-secondary

# CORS: comma-separated list of allowed origins. Use "*" only for local dev.
CORS_ORIGINS=*

# Rate limits (requests per window, per API key)
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX=60
RATE_LIMIT_SEARCH_MAX=20
RATE_LIMIT_PRODUCT_MAX=40

# Timeouts (ms) — used later by the Playwright layer
UPSTREAM_TIMEOUT_MS=15000
REQUEST_BUDGET_MS=20000

# Playwright (reserved for Phase 4; not used yet)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_PROXY_URL=
